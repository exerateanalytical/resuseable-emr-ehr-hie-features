<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-offline-sync-device-revocation" author="opes-healthcore">
        <createTable tableName="hc_sync_devices">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="device_node_id" type="varchar(80)"><constraints nullable="false"/></column>
            <column name="device_platform" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="assigned_user_id" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="device_status" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="remote_wipe_required" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="remote_wipe_confirmed_at" type="${ts_type}"/>
            <column name="revoked_by" type="varchar(120)"/>
            <column name="revoked_reason" type="varchar(300)"/>
            <column name="registered_at" type="${ts_type}"><constraints nullable="false"/></column>
            <column name="revoked_at" type="${ts_type}"/>
            <column name="last_sync_at" type="${ts_type}"/>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="hc_sync_devices" columnNames="facility_id,device_node_id" constraintName="uq_sync_device_fac_node"/>
    </changeSet>
</databaseChangeLog>
