<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.opeshealth.healthcore</groupId>
    <artifactId>healthcore-bom</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Opes HealthCore Bill of Materials</name>

    <properties>
        <spring-boot.version>4.0.0</spring-boot.version>
        <hapi-fhir.version>8.0.0</hapi-fhir.version>
        <hapi-hl7v2.version>2.5.1</hapi-hl7v2.version>
        <liquibase.version>4.31.1</liquibase.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <caffeine.version>3.2.0</caffeine.version>
        <springdoc.version>3.0.0</springdoc.version>
        <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
        <archunit.version>1.4.0</archunit.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <postgresql.version>42.7.5</postgresql.version>
        <mssql.version>12.10.0.jre11</mssql.version>
        <mysql.version>9.2.0</mysql.version>
