<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-mpi-tables" author="jude.nshome@opeshealthsystems.com">
        <createTable tableName="hc_patients">
            <column name="id" type="${uuid_type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="facility_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="mrn" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="family_name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="given_name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="birth_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="blood_group" type="VARCHAR(8)"/>
            <column name="primary_phone" type="VARCHAR(64)"/>
            <column name="preferred_language" type="VARCHAR(16)" defaultValue="en"/>
            <column name="golden_record" type="${bool_type}" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="surviving_patient_id" type="${uuid_type}"/>
            <column name="active" type="${bool_type}" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deceased" type="${bool_type}" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${ts_type}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${ts_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_hc_patient_fac_mrn" tableName="hc_patients" unique="true">
            <column name="facility_id"/>
            <column name="mrn"/>
        </createIndex>

        <createIndex indexName="idx_hc_patient_dob_gender" tableName="hc_patients">
            <column name="birth_date"/>
            <column name="gender"/>
        </createIndex>

        <createTable tableName="hc_patient_identifiers">
            <column name="id" type="${uuid_type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="identifier_system" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_value" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="blind_index" type="VARCHAR(88)">
                <constraints nullable="false"/>
            </column>
            <column name="biometric_template_hash" type="VARCHAR(128)"/>
        </createTable>

        <createIndex indexName="idx_hc_pat_ident_blind" tableName="hc_patient_identifiers">
            <column name="identifier_system"/>
            <column name="blind_index"/>
        </createIndex>

        <createTable tableName="hc_patient_demographics">
            <column name="id" type="${uuid_type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="address_line" type="VARCHAR(250)"/>
            <column name="city_or_village" type="VARCHAR(120)"/>
            <column name="region_or_state" type="VARCHAR(120)"/>
            <column name="country" type="VARCHAR(64)"/>
            <column name="emergency_contact_name" type="VARCHAR(160)"/>
            <column name="emergency_contact_phone" type="VARCHAR(64)"/>
            <column name="emergency_relationship" type="VARCHAR(40)"/>
        </createTable>

        <createTable tableName="hc_patient_phonetics">
            <column name="patient_id" type="${uuid_type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_metaphone" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="given_metaphone" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="birth_year" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_hc_phonetic_block" tableName="hc_patient_phonetics">
            <column name="family_metaphone"/>
            <column name="birth_year"/>
        </createIndex>

        <createTable tableName="hc_patient_merges">
            <column name="id" type="${uuid_type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="facility_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="source_patient_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="surviving_patient_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="merged_by" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(300)"/>
            <column name="reversed" type="${bool_type}" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="merged_at" type="${ts_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
