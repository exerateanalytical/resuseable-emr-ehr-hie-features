# =============================================================================
# Opes HealthCore SDK — Environment Variables Template (No Secrets)
# Author / Architect : Jude Nshome — Opes Health Systems (nshome@opesware.com)
# Website            : https://www.opeshealthsystems.com | Douala, Cameroon
# =============================================================================
SPRING_PROFILES_ACTIVE=postgres,keycloak
HEALTHCORE_DB_URL=jdbc:postgresql://localhost:5432/healthcore
HEALTHCORE_DB_USER=healthcore_app
HEALTHCORE_DB_PASSWORD=change_me_in_prod

# Windows SQL Server example (set SPRING_PROFILES_ACTIVE=mssql,keycloak)
# HEALTHCORE_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=healthcore;encrypt=true;trustServerCertificate=true

# MySQL 8.4 example (set SPRING_PROFILES_ACTIVE=mysql,keycloak)
# HEALTHCORE_DB_URL=jdbc:mysql://localhost:3306/healthcore?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/opes-healthcore
KEYCLOAK_JWK_SET_URI=http://localhost:8085/realms/opes-healthcore/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=healthcore-mobile-kmp
KEYCLOAK_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8085
# AUTH0_ISSUER_URI=https://your-tenant.us.auth0.com/
# AUTH0_AUDIENCE=https://api.opeshealthsystems.com

HIE_ENDPOINT_URL=http://localhost:8081/fhir
HIE_RELAY_ENABLED=true

HEALTHCORE_RATE_LIMIT_ENABLED=true
HEALTHCORE_RATE_LIMIT_FHIR_RPM=120
HEALTHCORE_RATE_LIMIT_BUNDLE_RPM=30
HEALTHCORE_RATE_LIMIT_ANON_RPM=60
HEALTHCORE_GRAPHIQL_ENABLED=false
HEALTHCORE_FLYWAY_ENABLED=true
HEALTHCORE_LIQUIBASE_ENABLED=true
HEALTHCORE_SWAGGER_ENABLED=true
HEALTHCORE_OPENAPI_ENABLED=true

