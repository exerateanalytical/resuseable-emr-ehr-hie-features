# =============================================================================
# Opes HealthCore SDK — Environment Variables Template (NO REAL SECRETS)
# Copy to .env (git-ignored) or inject via Vault / Kubernetes Secrets / Cloud KMS.
# =============================================================================

# Database connection
HEALTHCORE_DB_URL=jdbc:postgresql://localhost:5432/healthcore
HEALTHCORE_DB_USER=healthcore_app
HEALTHCORE_DB_PASSWORD=

# Schema migration owner (Liquibase is canonical default; keep Flyway false unless replacing Liquibase)
HEALTHCORE_LIQUIBASE_ENABLED=true
HEALTHCORE_FLYWAY_ENABLED=false

# Cryptographic PII Vault keys (Base64-encoded 32-byte AES-256 and HMAC-SHA256 keys; required in prod)
HEALTHCORE_PII_AES_KEY_B64=
HEALTHCORE_PII_HMAC_KEY_B64=

# Webhook & Offline QR HMAC signing secrets (empty fails closed)
HEALTHCORE_HIE_WEBHOOK_SECRET=
HEALTHCORE_UHC_QR_SIGNING_SECRET=
HEALTHCORE_UHC_MOMO_WEBHOOK_SECRET=

# Clinical AI (server-side Gemini API key; required when Clinical AI endpoints are invoked)
HEALTHCORE_AI_ENABLED=true
GEMINI_API_KEY=

# Optional external integrations (all disabled by default in application.yml)
HEALTHCORE_PACS_DICOMWEB_URL=
HEALTHCORE_DHIS2_URL=
HEALTHCORE_DHIS2_USER=
HEALTHCORE_DHIS2_PASSWORD=
HEALTHCORE_FHIR_TERMINOLOGY_URL=
HEALTHCORE_MQTT_URL=tcp://localhost:1883

# OIDC / Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/opes-healthcore
KEYCLOAK_JWK_SET_URI=http://localhost:8085/realms/opes-healthcore/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=healthcore-mobile-kmp

# Development-only flag (blocked automatically when Spring profile 'prod' or 'production' is active)
HEALTHCORE_WORKFORCE_ALLOW_UNREGISTERED_IN_DEV=false
