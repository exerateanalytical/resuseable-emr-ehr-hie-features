{
  "info": {
    "name": "OPES HealthCore \u2014 Standalone Pharmacy Example",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runnable synthetic smoke collection for OPES HealthCore standalone example."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "facilityId",
      "value": "01950000-0000-7000-8000-000000000001"
    },
    {
      "key": "jwtToken",
      "value": "REPLACE_WITH_DEV_JWT"
    }
  ],
  "item": [
    {
      "name": "Actuator Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "Primary Domain Workflow Smoke Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Facility-Id",
            "value": "{{facilityId}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pharmacy/commerce/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "pharmacy",
            "commerce",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"SYN-AMOX-500\",\n  \"genericName\": \"Amoxicillin Trihydrate 500mg\",\n  \"brandName\": \"SyntheMox\",\n  \"atcCode\": \"J01CA04\",\n  \"dosageForm\": \"CAPSULE\",\n  \"controlledSubstance\": false,\n  \"reorderThreshold\": 25,\n  \"unitPrice\": 1500.0,\n  \"currency\": \"XAF\"\n}"
        }
      }
    }
  ]
}
