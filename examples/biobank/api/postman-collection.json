{
  "info": {
    "name": "OPES HealthCore \u2014 ISO 20387 Biobank Example",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runnable synthetic smoke collection for OPES HealthCore standalone example."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "facilityId",
      "value": "01950000-0000-7000-8000-000000000006"
    },
    {
      "key": "jwtToken",
      "value": "REPLACE_WITH_DEV_JWT"
    }
  ],
  "item": [
    {
      "name": "Actuator Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "Primary Domain Workflow Smoke Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Facility-Id",
            "value": "{{facilityId}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lifesciences/biobank/aliquots",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "lifesciences",
            "biobank",
            "aliquots"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"aliquotBarcode\": \"SYN-CRYO-0001\",\n  \"donorPseudonym\": \"DONOR-SYN-01\",\n  \"specimenMatrix\": \"PLASMA\",\n  \"volumeMicroliters\": 500,\n  \"freezerCode\": \"LN2-01\",\n  \"rackCode\": \"R1\",\n  \"boxCode\": \"B1\",\n  \"slotCode\": \"A1\",\n  \"consentActive\": true\n}"
        }
      }
    }
  ]
}
