{
  "info": {
    "name": "OPES HealthCore \u2014 Pharmaceutical Manufacturing & QMS Example",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runnable synthetic smoke collection for OPES HealthCore standalone example."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "facilityId",
      "value": "01950000-0000-7000-8000-000000000004"
    },
    {
      "key": "jwtToken",
      "value": "REPLACE_WITH_DEV_JWT"
    }
  ],
  "item": [
    {
      "name": "Actuator Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "Primary Domain Workflow Smoke Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Facility-Id",
            "value": "{{facilityId}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pharma/qms/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "pharma",
            "qms",
            "documents"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"documentCode\": \"SOP-SYN-001\",\n  \"documentVersion\": \"v1.0\",\n  \"documentType\": \"SOP\",\n  \"title\": \"Synthetic Tablet Compression Line Clearance\",\n  \"documentBody\": \"Verify zero residual tablets prior to batch start.\",\n  \"authoredBy\": \"qa.author.syn\",\n  \"reviewDueDate\": \"2027-01-01\"\n}"
        }
      }
    }
  ]
}
