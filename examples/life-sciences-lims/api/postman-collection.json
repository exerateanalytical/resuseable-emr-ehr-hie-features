{
  "info": {
    "name": "OPES HealthCore \u2014 Life Sciences Research LIMS Example",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runnable synthetic smoke collection for OPES HealthCore standalone example."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "facilityId",
      "value": "01950000-0000-7000-8000-000000000005"
    },
    {
      "key": "jwtToken",
      "value": "REPLACE_WITH_DEV_JWT"
    }
  ],
  "item": [
    {
      "name": "Actuator Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "Primary Domain Workflow Smoke Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Facility-Id",
            "value": "{{facilityId}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lifesciences/lims/studies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "lifesciences",
            "lims",
            "studies"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studyCode\": \"SYN-BIO-2026\",\n  \"title\": \"Synthetic Malaria Biomarker Assay Validation\",\n  \"principalInvestigator\": \"dr.syn.pi\",\n  \"protocolVersion\": \"1.0\"\n}"
        }
      }
    }
  ]
}
