<service>
    <id>OpesHealthCoreService</id>
    <name>Opes HealthCore Platform (Java 25 + SQL Server)</name>
    <description>Offline-first EMR, EHR, HIE, PIS, LIS, and UHC/CBHI Healthcare Platform</description>
    <executable>java</executable>
    <arguments>-Xms1g -Xmx4g -XX:+UseZGC -Dspring.profiles.active=mssql,keycloak -jar healthcore-quickstart-host-1.0.0.jar</arguments>
    <log mode="roll-by-size">
        <sizeThreshold>10240</sizeThreshold>
        <keepFiles>8</keepFiles>
    </log>
    <onfailure action="restart" delay="10 sec"/>
</service>
