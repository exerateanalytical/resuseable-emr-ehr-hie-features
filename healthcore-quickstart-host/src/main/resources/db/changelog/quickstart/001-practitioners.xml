<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-quickstart-practitioners" author="jude.nshome@opeshealthsystems.com">
        <createTable tableName="hc_practitioners">
            <column name="id" type="${uuid_type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="facility_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="identifier_system" type="VARCHAR(120)"/>
            <column name="identifier_value" type="VARCHAR(120)"/>
            <column name="identifier_use" type="VARCHAR(24)" defaultValue="OFFICIAL"/>
            <column name="assigner_display" type="VARCHAR(160)"/>
            <column name="active" type="${bool_type}" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="name_prefix" type="VARCHAR(32)"/>
            <column name="family_name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="given_name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_suffix" type="VARCHAR(32)"/>
            <column name="gender" type="VARCHAR(16)" defaultValue="UNKNOWN">
                <constraints nullable="false"/>
            </column>
            <column name="birth_date" type="DATE"/>
            <column name="phone" type="VARCHAR(64)"/>
            <column name="email" type="VARCHAR(160)"/>
            <column name="address_use" type="VARCHAR(24)" defaultValue="WORK"/>
            <column name="address_line" type="VARCHAR(250)"/>
            <column name="city" type="VARCHAR(120)"/>
            <column name="district" type="VARCHAR(120)"/>
            <column name="state" type="VARCHAR(120)"/>
            <column name="postal_code" type="VARCHAR(32)"/>
            <column name="country" type="VARCHAR(64)"/>
            <column name="qualification_code" type="VARCHAR(64)"/>
            <column name="qualification_display" type="VARCHAR(160)"/>
            <column name="qualification_issuer" type="VARCHAR(160)"/>
            <column name="communication_code" type="VARCHAR(24)" defaultValue="en"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${ts_type}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${ts_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_hc_practitioners_fac_active" tableName="hc_practitioners">
            <column name="facility_id"/>
            <column name="active"/>
        </createIndex>

        <createIndex indexName="idx_hc_practitioners_fac_ident" tableName="hc_practitioners">
            <column name="facility_id"/>
            <column name="identifier_system"/>
            <column name="identifier_value"/>
        </createIndex>

        <createIndex indexName="idx_hc_practitioners_name" tableName="hc_practitioners">
            <column name="family_name"/>
            <column name="given_name"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
