<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="emergency-nursing-001-tables" author="opes-healthcore">
        <createTable tableName="hc_ed_visits">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="encounter_id" type="${uuid_type}"/>
            <column name="chief_complaint" type="varchar(300)"><constraints nullable="false"/></column>
            <column name="esi_level" type="int"><constraints nullable="false"/></column>
            <column name="arrival_mode" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="assigned_bay" type="varchar(48)"/>
            <column name="triage_nurse_id" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="attending_clinician_id" type="varchar(120)"/>
            <column name="visit_status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="disposition" type="varchar(32)"/>
            <column name="arrived_at" type="${ts_type}"><constraints nullable="false"/></column>
            <column name="disposition_at" type="${ts_type}"/>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="hc_ed_visits" indexName="idx_ed_visits_facility_status_esi">
            <column name="facility_id"/><column name="visit_status"/><column name="esi_level"/>
        </createIndex>

        <createTable tableName="hc_nursing_assignments">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="ward_code" type="varchar(48)"><constraints nullable="false"/></column>
            <column name="bed_code" type="varchar(48)"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="nurse_id" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="shift_code" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="active_flag" type="${bool_type}" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="assigned_at" type="${ts_type}"><constraints nullable="false"/></column>
            <column name="ended_at" type="${ts_type}"/>
        </createTable>
        <createIndex tableName="hc_nursing_assignments" indexName="idx_nursing_assign_facility_active">
            <column name="facility_id"/><column name="nurse_id"/><column name="active_flag"/>
        </createIndex>

        <createTable tableName="hc_nursing_news2_scores">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="encounter_id" type="${uuid_type}"/>
            <column name="respiratory_rate" type="int"><constraints nullable="false"/></column>
            <column name="spo2_percent" type="int"><constraints nullable="false"/></column>
            <column name="supplemental_o2" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="systolic_bp" type="int"><constraints nullable="false"/></column>
            <column name="heart_rate" type="int"><constraints nullable="false"/></column>
            <column name="temperature_c" type="double"><constraints nullable="false"/></column>
            <column name="consciousness_acvpu" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="total_score" type="int"><constraints nullable="false"/></column>
            <column name="risk_band" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="escalation_required" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="recorded_by" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="recorded_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_discharge_readiness">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="encounter_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="med_reconciliation_complete" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="discharge_summary_signed" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="patient_education_documented" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="follow_up_scheduled" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="billing_cleared" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="ready_for_discharge" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="updated_by" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="updated_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="hc_discharge_readiness" columnNames="facility_id,encounter_id" constraintName="uq_discharge_readiness_fac_enc"/>
    </changeSet>
</databaseChangeLog>
