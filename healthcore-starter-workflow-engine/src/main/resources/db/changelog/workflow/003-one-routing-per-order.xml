<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Idempotency keys can differ on redelivery; the actual clinical order is the
         durable entity that must not create multiple department routing tasks. -->
    <changeSet id="wf-journey-006-order-routing-unique" author="opes-healthcore">
        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM (
                    SELECT facility_id, order_id
                    FROM hc_order_routing_tasks
                    GROUP BY facility_id, order_id
                    HAVING COUNT(*) &gt; 1
                ) duplicate_order_routes
            </sqlCheck>
        </preConditions>
        <addUniqueConstraint tableName="hc_order_routing_tasks"
                             columnNames="facility_id,order_id"
                             constraintName="uq_hc_order_routing_order"/>
        <rollback>
            <dropUniqueConstraint tableName="hc_order_routing_tasks"
                                  constraintName="uq_hc_order_routing_order"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
