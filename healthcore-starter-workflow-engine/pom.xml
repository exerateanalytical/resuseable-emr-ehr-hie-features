         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.opeshealth.healthcore</groupId>
        <artifactId>healthcore-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>healthcore-starter-workflow-engine</artifactId>
    <name>Opes HealthCore Composable Clinical &amp; HIE Workflow Engine Starter</name>

    <dependencies>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-persistence-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-security-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
