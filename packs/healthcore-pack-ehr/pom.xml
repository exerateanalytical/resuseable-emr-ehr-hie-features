            <artifactId>healthcore-starter-patient-portal</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-starter-templates-dashboards</artifactId>
        </dependency>
    </dependencies>
</project>
