<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.opeshealth.healthcore</groupId>
        <artifactId>healthcore-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>healthcore-pack-his</artifactId>
    <name>Opes HealthCore Capability Pack 07 — Composable Hospital Information System (HIS)</name>
    <description>
        Composable Hospital Information System pack built from independently selectable starters
        and 5 deployment profiles: outpatient-hospital, general-hospital, multispecialty,
        tertiary-referral, and multi-facility-network. Zero pharmaceutical manufacturing or life-sciences coupling.
    </description>
    <dependencies>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-pack-ehr</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-starter-hospital-ops</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-starter-emergency-nursing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-starter-pharmacy-lis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-starter-uhc-billing</artifactId>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>outpatient-hospital</id>
            <dependencies>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-revenue-coding-claims</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>general-hospital</id>
            <dependencies>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-radiology</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-revenue-coding-claims</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-workforce-roster</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>multispecialty</id>
            <dependencies>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-radiology</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-surgery-ot</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-blood-bank</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-revenue-coding-claims</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>tertiary-referral</id>
            <dependencies>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-radiology</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-surgery-ot</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-blood-bank</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-biomedical-coldchain</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-crvs-mortuary</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-analytics</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-revenue-coding-claims</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>multi-facility-network</id>
            <dependencies>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-tenant-governance</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-offline-sync</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-integration-ops</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.opeshealth.healthcore</groupId>
                    <artifactId>healthcore-starter-analytics</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
