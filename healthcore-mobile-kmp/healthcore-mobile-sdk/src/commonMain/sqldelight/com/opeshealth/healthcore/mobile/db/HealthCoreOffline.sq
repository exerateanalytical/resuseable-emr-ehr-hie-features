-- =============================================================================
-- Opes HealthCore Mobile SDK — Encrypted SQLite/SQLCipher Offline-First Schema
-- Author / Architect : Jude Nshome — Opes Health Systems (nshome@opesware.com)
-- Website            : https://www.opeshealthsystems.com | Douala, Cameroon
-- =============================================================================

CREATE TABLE local_patient (
    id TEXT NOT NULL PRIMARY KEY,
    facility_id TEXT NOT NULL,
    mrn TEXT NOT NULL,
    family_name TEXT NOT NULL,
    given_name TEXT NOT NULL,
    birth_date TEXT NOT NULL,
    gender TEXT NOT NULL,
    blood_group TEXT,
    allergies_csv TEXT,
    hlc_timestamp TEXT NOT NULL
);

CREATE TABLE local_vital_signs (
    id TEXT NOT NULL PRIMARY KEY,
    patient_id TEXT NOT NULL,
    temp_celsius REAL,
    heart_rate_bpm INTEGER,
    resp_rate_per_min INTEGER,
    systolic_bp INTEGER,
    spo2_percent INTEGER,
    news2_score INTEGER NOT NULL,
    recorded_at TEXT NOT NULL
);

CREATE TABLE local_clinical_note (
    id TEXT NOT NULL PRIMARY KEY,
    patient_id TEXT NOT NULL,
    subjective TEXT,
    objective TEXT,
    assessment TEXT,
    plan_text TEXT,
    specialty_code TEXT,
    stylus_strokes_json TEXT,
    status TEXT NOT NULL,
    hlc_timestamp TEXT NOT NULL
);

CREATE TABLE local_sync_outbox (
    id TEXT NOT NULL PRIMARY KEY,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    hlc_timestamp TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE local_sync_checkpoint (
    facility_id TEXT NOT NULL PRIMARY KEY,
    last_sync_seq INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT NOT NULL
);

selectAllPatients:
SELECT * FROM local_patient ORDER BY family_name ASC;

insertOrReplacePatient:
INSERT OR REPLACE INTO local_patient(id, facility_id, mrn, family_name, given_name, birth_date, gender, blood_group, allergies_csv, hlc_timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertVitalSigns:
INSERT INTO local_vital_signs(id, patient_id, temp_celsius, heart_rate_bpm, resp_rate_per_min, systolic_bp, spo2_percent, news2_score, recorded_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

enqueueOutboxMutation:
INSERT INTO local_sync_outbox(id, entity_type, entity_id, operation, hlc_timestamp, payload_json, synced)
VALUES (?, ?, ?, ?, ?, ?, 0);

selectPendingOutbox:
SELECT * FROM local_sync_outbox WHERE synced = 0 ORDER BY hlc_timestamp ASC;

markOutboxSynced:
UPDATE local_sync_outbox SET synced = 1 WHERE id = ?;
