<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-hospital-ops-expanded" author="jude.nshome@opeshealthsystems.com">
        <createTable tableName="hc_blood_donors">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="donor_code" type="VARCHAR(64)"><constraints nullable="false" unique="true"/></column>
            <column name="full_name" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="abo_rhd" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="hemoglobin_g_dl" type="DECIMAL(4,1)"><constraints nullable="false"/></column>
            <column name="eligible" type="${bool_type}" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="deferral_reason" type="VARCHAR(240)"/>
            <column name="deferral_until" type="DATE"/>
            <column name="registered_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_transfusion_reactions">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="blood_unit_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="reaction_type" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="severity" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="clinical_notes" type="VARCHAR(500)"/>
            <column name="reported_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_anesthesia_pacu_logs">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="surgery_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="asa_class" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="induction_agent" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="airway_management" type="VARCHAR(80)"/>
            <column name="estimated_blood_loss_ml" type="INT"/>
            <column name="pacu_aldrete_score" type="INT"/>
            <column name="anesthetist_id" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="recorded_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_biomed_maintenance">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="equipment_tag" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="equipment_name" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="last_pm_on" type="DATE"/>
            <column name="calibration_due_on" type="DATE"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="notes" type="VARCHAR(300)"/>
        </createTable>

        <createTable tableName="hc_workforce_rosters">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="practitioner_id" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="department_code" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="shift_type" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="shift_date" type="DATE"><constraints nullable="false"/></column>
            <column name="on_call_phone" type="VARCHAR(64)"/>
        </createTable>

        <addColumn tableName="hc_crvs_events">
            <column name="mccd_part1_immediate" type="VARCHAR(240)"/>
            <column name="mccd_part1_underlying" type="VARCHAR(240)"/>
            <column name="mortuary_custody_status" type="VARCHAR(32)"/>
            <column name="released_to_next_of_kin" type="VARCHAR(160)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
