<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-emr-ward-workflows" author="jude.nshome@opeshealthsystems.com">
        <createTable tableName="hc_fluid_balance">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="admission_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="direction" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="route" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="volume_ml" type="INT"><constraints nullable="false"/></column>
            <column name="recorded_by" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="recorded_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_shift_handovers">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="admission_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="shift_name" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="situation" type="${clob_type}"><constraints nullable="false"/></column>
            <column name="background" type="${clob_type}"/>
            <column name="assessment" type="${clob_type}"/>
            <column name="recommendation" type="${clob_type}"/>
            <column name="handed_by" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="received_by" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="recorded_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_med_reconciliations">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="admission_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="medication_code" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="medication_display" type="VARCHAR(240)"><constraints nullable="false"/></column>
            <column name="reconciliation_action" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="reconciled_by" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="reconciled_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_clinical_referrals">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="encounter_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="target_facility" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="specialty" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="outcome_notes" type="${clob_type}"/>
            <column name="created_at" type="${ts_type}"><constraints nullable="false"/></column>
            <column name="completed_at" type="${ts_type}"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
