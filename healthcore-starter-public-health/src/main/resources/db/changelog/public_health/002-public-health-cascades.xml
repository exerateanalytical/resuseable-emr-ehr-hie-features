<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-public-health-cascades" author="jude.nshome@opeshealthsystems.com">
        <createTable tableName="hc_idsr_cif_forms">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="surveillance_case_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="disease_icd10" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="symptom_onset_date" type="DATE"><constraints nullable="false"/></column>
            <column name="travel_history" type="VARCHAR(300)"/>
            <column name="lab_specimen_taken" type="${bool_type}" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="lab_result" type="VARCHAR(120)"/>
            <column name="investigator_id" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="completed_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_chronic_cascades">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="program_code" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="regimen" type="VARCHAR(160)"><constraints nullable="false"/></column>
            <column name="enrolled_on" type="DATE"><constraints nullable="false"/></column>
            <column name="viral_load_copies_ml" type="INT"/>
            <column name="adherence_percent" type="INT" defaultValueNumeric="100"><constraints nullable="false"/></column>
            <column name="outcome_status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="updated_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
