<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-uhc-billing-tables" author="jude.nshome@opeshealthsystems.com">
        <createTable tableName="hc_tariff_schedules">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="service_code" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="service_name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="payer_tier" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="unit_price_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(8)" defaultValue="XAF"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_patient_accounts">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(8)" defaultValue="XAF"><constraints nullable="false"/></column>
            <column name="balance_minor" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_ledger_entries">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="entry_type" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="amount_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="reference_code" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(300)"/>
            <column name="posted_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_cbhi_policies">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="scheme_name" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="policy_number" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="household_id" type="VARCHAR(64)"/>
            <column name="coverage_percent" type="INT" defaultValueNumeric="80"><constraints nullable="false"/></column>
            <column name="valid_from" type="DATE"><constraints nullable="false"/></column>
            <column name="valid_until" type="DATE"><constraints nullable="false"/></column>
            <column name="active" type="${bool_type}" defaultValueBoolean="true"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_insurance_claims">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="facility_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="patient_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="policy_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="adjudication_model" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="total_billed_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="insurer_share_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="patient_copay_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="submitted_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>

        <createTable tableName="hc_payment_transactions">
            <column name="id" type="${uuid_type}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="${uuid_type}"><constraints nullable="false"/></column>
            <column name="provider_code" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="external_tx_ref" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="amount_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="created_at" type="${ts_type}"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
