<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.opeshealth.healthcore</groupId>
        <artifactId>healthcore-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>healthcore-starter-diagnostics-core</artifactId>
    <name>Opes HealthCore Starter — Diagnostics Center Core (ISO 15189-Aligned)</name>
    <description>
        Modality-neutral diagnostics center operations starter usable independently by medical
        laboratories OR imaging/radiology centers without cross-pulling the other modality or EMR/HIS:
        referring clinicians/facilities, test &amp; exam catalogs/packages, specimen/order rejection &amp;
        recollection, Turnaround-Time (TAT) SLA monitoring, and ISO 15189 quality incidents &amp; CAPA.
    </description>
    <dependencies>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-persistence-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.opeshealth.healthcore</groupId>
            <artifactId>healthcore-security-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
